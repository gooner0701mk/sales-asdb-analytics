# Supabase（クラウド保存・ログイン）を使う場合のみ設定
# 空のままなら、従来どおりブラウザの localStorage のみで動作します
#
# VITE_SUPABASE_URL は Supabase の「Project URL」のみ
# （例: https://xxxx.supabase.co）。末尾に /rest/v1/ を付けないでください。
# Vercel に貼るとき、値の前後に引用符が付いていても動くようアプリ側で除去します。

VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=（Settings → API の anon public キー）

# 任意: 新規登録・確認メール再送の「戻り先」を固定（本番URLと Supabase の Redirect URLs を一致させる）
# 未設定のときは、ブラウザが開いているページの origin が使われます。
# VITE_AUTH_EMAIL_REDIRECT_URL=https://sales-asdb-analytics-mum3.vercel.app/

# 任意: クラウド共有データを会社ごとに分ける（英小文字・数字・-_ 推奨）。未設定は default。
# デプロイごとに別値にすると、同じ Supabase でも他社の shared_app_state と混ざりません。
# VITE_COMPANY_ID=my-company-slug
